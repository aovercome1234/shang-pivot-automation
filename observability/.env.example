# 复制为 .env（同目录）后按需修改；不填则用这里的默认值。
# 部署与运维脚本会自动读取本目录下的 .env（若存在）。

# 被测服务器（平台也部署在这台机器上）
SHANG_SSH_HOST=111.170.33.2
SHANG_SSH_PORT=28536

# 能登录上面服务器的私钥文件名（位于 ~/.ssh/ 下）。
# 默认复用本机已有的 projectku_psyidc（它对本服务器有效）；
# 若你为尚品汇单独生成了一把钥匙（比如 shang-pivot_psyidc），把公钥装到服务器后改成它的文件名。
SHANG_SSH_KEY_NAME=projectku_psyidc

# SkyWalking 单接口链路探针（verify_skywalking_trace.py）只读账号；不填则脚本会提示缺少凭据
SW_USER=
SW_PASSWORD=
SW_SERVICE_NAME=shang-pivot

# k6 客户端指标 remote write；不填默认目标服务器 127.0.0.1:9090/api/v1/write
K6_PROMETHEUS_RW_SERVER_URL=

# k6 执行标识与 summary 归档目录；不填由 platform.sh 自动生成
PERF_RUN_ID=
PERF_ARTIFACT_DIR=
