        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "projectku-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"shang-pivot\",uri!~\"/actuator.*\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"shang-pivot\",uri!~\"/actuator.*\"}[1m]))",
