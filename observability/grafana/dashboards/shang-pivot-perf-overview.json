    {
      "id": 7,
      "type": "timeseries",
      "title": "客户端延迟拆解（区分网络与服务端）",
      "description": "k6 分段计时。connecting 是纯 TCP 建连开销；waiting 是从请求发出到收到首字节，包含网络往返 + 服务端处理。若 waiting 远大于服务端指标，瓶颈在链路而非服务端。",
      "datasource": {
        "type": "prometheus",
        "uid": "projectku-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "projectku-prometheus"
          },
          "expr": "avg(k6_http_req_duration_p95{app=\"shang-pivot\"})",
          "legendFormat": "总耗时 duration"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "projectku-prometheus"
          },
          "expr": "avg(k6_http_req_waiting_p95{app=\"shang-pivot\"})",
          "legendFormat": "等待响应 waiting（含 RTT）"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "projectku-prometheus"
          },
          "expr": "avg(k6_http_req_connecting_p95{app=\"shang-pivot\"})",
          "legendFormat": "TCP 建连 connecting"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "projectku-prometheus"
          },
          "expr": "avg(k6_http_req_receiving_p95{app=\"shang-pivot\"})",
          "legendFormat": "接收 receiving"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "projectku-prometheus"
          },
          "expr": "avg(k6_http_req_sending_p95{app=\"shang-pivot\"})",
          "legendFormat": "发送 sending"
        }
      ]
    },
