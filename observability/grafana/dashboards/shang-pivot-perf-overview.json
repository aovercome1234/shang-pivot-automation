    {
      "id": 3,
      "type": "stat",
      "title": "客户端失败率",
      "description": "失败请求数 / 总请求数，按计数器比值聚合。不能用 max(k6_http_req_failed_rate)：k6 按 URL 打标签，只请求过一次且失败的那个 URL 比率是 1.0，会把整体误显示为 100%。",
      "datasource": {
        "type": "prometheus",
        "uid": "projectku-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "projectku-prometheus"
          },
          "expr": "(sum(rate(k6_http_reqs_total{app=\"shang-pivot\",expected_response=\"false\"}[5m])) or vector(0)) / clamp_min(sum(rate(k6_http_reqs_total{app=\"shang-pivot\"}[5m])), 0.000001)",
          "legendFormat": "失败率"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "断言通过率",
      "description": "k6 checks 通过率。低于阈值即说明业务断言出现失败（含业务 code != 200）。",
