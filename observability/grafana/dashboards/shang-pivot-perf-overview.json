{
  "uid": "shang-pivot-perf-overview",
  "title": "尚品汇性能测试总览",
  "tags": [
    "shang-pivot",
    "perf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "客户端 P95",
      "description": "k6 侧 P95。k6 按 URL 打标签，无法在 Prometheus 里还原全局 P95，故同时给出两个口径：各 URL 平均（典型值）与各 URL 最大（最差值，容量判定用这个）。全局 P95 以 k6 运行结束的终端汇总为准。",
      "datasource": {
        "type": "prometheus",
        "uid": "projectku-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "projectku-prometheus"
          },
          "expr": "avg(k6_http_req_duration_p95{app=\"shang-pivot\"})",
          "legendFormat": "各 URL 平均"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "projectku-prometheus"
          },
          "expr": "max(k6_http_req_duration_p95{app=\"shang-pivot\"})",
          "legendFormat": "最差 URL"
        }
      ]
    },
