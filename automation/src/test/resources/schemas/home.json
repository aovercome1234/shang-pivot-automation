{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["feed", "slots"],
  "properties": {
    "feed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["spuId", "name", "price"],
        "properties": {
          "spuId": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "price": {"type": "number", "minimum": 0},
          "subtitle": {"type": ["string", "null"]},
          "pic": {"type": ["string", "null"]}
        }
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "title"],
        "properties": {
          "code": {"type": "string"},
          "title": {"type": "string"},
          "items": {"type": "array"}
        }
      }
    }
  }
}
