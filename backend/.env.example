# ================= Shang Backend 环境配置（模板） =================
# 用法：cp .env.example .env 后填写真实值。本模板可提交 git，.env 勿提交。
# 由 application.yaml 的 spring.config.import=optional:file:./.env[.properties] 读取。
# 格式：KEY=VALUE（每行一个，`#` 注释，勿加 export；敏感值留空则用 application.yaml 默认）。

# --- 应用 ---
SERVER_PORT=8080

# --- 数据库 PostgreSQL (pgvector) ---
# 应用只读 DB_URL。宿主机映射非 5432 端口时写进 URL；经端口转发/云映射访问建议加 sslmode=disable
DB_URL=jdbc:postgresql://localhost:5432/shang?sslmode=disable&stringtype=unspecified&connectTimeout=5&socketTimeout=30&tcpKeepAlive=true
DB_USERNAME=shang
DB_PASSWORD=
DB_DATABASE=shang
DB_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# --- 对象存储 MinIO（S3 兼容）---
# endpoint 可为 host:port（应用内会补 http://）或完整 URL
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=

# 公网访问前缀，留空则使用 http://{endpoint}/{bucket}/{objectKey}
# MINIO_PUBLIC_BASE_URL=http://localhost:9000/shang-pivot

# --- 鉴权 JWT（P1 落地时填写）---
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- 跨源白名单（部署到域名/公网 IP 时必填，逗号分隔、写精确 Origin）---
# 不填时用 application.yaml 的默认值（localhost + 111.170.33.2:60084/60085）。
# 现象：浏览器里登录/注册报 "Invalid CORS request"（403），但 curl 不带 Origin 正常 → 就是这里缺部署域。
# SHANG_CORS_ALLOWED_ORIGINS=http://111.170.33.2:60084,http://111.170.33.2:60085

# --- 智能客服 LLM（P3 接入时填写）---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-plus

# --- 微信小程序（P2 接入时填写）---
MINIAPP_APPID=
MINIAPP_SECRET=